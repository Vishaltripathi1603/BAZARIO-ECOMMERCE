# ==============================================================================
# Bazario Marketplace - Environment Configuration Example
# Copy this file to .env.local and fill in your Supabase project credentials.
# ==============================================================================

# 1. Supabase Project Configuration (Auth, Postgres, Storage, RLS)
# Find these in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Free Image API Keys (Optional for build-time image sourcing script)
# - Pexels: https://www.pexels.com/api/
# - Pixabay: https://pixabay.com/api/docs/
# - Unsplash: https://unsplash.com/developers
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# 3. Canonical Domain (Defaults to http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
